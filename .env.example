# Copy to .env and adjust. All values are optional — defaults shown.
# (These can also be changed at runtime from the WebUI ⚙ settings dialog,
#  which takes precedence over these environment variables.)

# Default Ollama (or OpenAI-compatible) endpoint.
# The WebUI settings dialog (saved to data/config.json) overrides this.
OLLAMA_URL=http://127.0.0.1:11434

# Port uvicorn binds to (127.0.0.1 only).
PORT=9130

# Data directory inside the container (glossaries.json / config.json / out/).
DATA_DIR=/data

# Timeout for a single PDF translation job, in seconds.
PDF_TIMEOUT_SECS=1800
